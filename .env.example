# Copy to .env and fill in locally. Never commit .env.
# In production these are set as environment variables on the host (Vercel).

# Postgres connection string (Neon). Leave empty locally to use a SQLite file (second_wind.db).
DATABASE_URL=

# Shared secret for verifying GitHub webhook signatures (HMAC SHA-256). Required: the webhook
# answers 503 without it. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# Your GitHub username: only commits by this user earn XP. Required by the webhook.
GITHUB_USERNAME=

# IANA time zone that decides where each day starts and ends (default: America/Sao_Paulo).
APP_TIMEZONE=
